<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the case with HelCAD's own solid engine. Expects the sihilisko-cad
       repository next to this one: ~/repos/can-emulator and ~/repos/sihilisko-cad. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../sihilisko-cad/src/Sihilisko.Cad.Core/Sihilisko.Cad.Core.csproj" />
  </ItemGroup>
</Project>
